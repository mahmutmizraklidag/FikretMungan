@{
    ViewData["Title"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.MetaTitle) ? "Anasayfa" : DataRequestModel.SiteSetting.MetaTitle;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.MetaDescription) ? "Anasayfa Uzm. Dr. Fikret MUNGAN" : DataRequestModel.SiteSetting.MetaDescription;
    ViewData["MetaKeywords"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.Keywords) ? "Anasayfa Uzm. Dr. Fikret MUNGAN" : DataRequestModel.SiteSetting.Keywords;
}

<!-- Content-->
<div class="template-content">

    <!-- Slider -->
    <div class="template-content-section template-padding-reset">

        <div class="swiper main-slider">
            <div class="swiper-wrapper">

                <div class="swiper-slide">
                    <div class="slide-background" style="background-image: url('media/image/_sample/slider/slider_slide1_background.png');"></div>

                    <div class="slide-content template-main">
                        <div class="slide-text-wrapper">
                            <h4 class="slide-subtitle tp-font-handlee">Uzm. Dr. Fikret Mungan</h4>
                            <h2 class="slide-title tp-font-lato-black">Bilimsel & Şefkatli</h2>
                            <h3 class="slide-desc tp-font-lato-light">Bir Hekimlik Anlayışı</h3>

                            <div class="slide-button">
                                <a asp-controller="Contact" asp-action="Index" class="template-component-button template-component-button-style-1">İletişime Geçin<i></i></a>
                            </div>
                        </div>
                        <div class="slide-image">
                            <img src="media/image/_sample/slider/slider_slide1_img1.png" alt="Doktor Muayenesi">
                        </div>
                    </div>
                </div>

                <div class="swiper-slide">
                    <div class="slide-background" style="background-image: url('media/image/_sample/slider/slider_slide2_background.png');"></div>

                    <div class="slide-content template-main">
                        <div class="slide-text-wrapper">
                            <h4 class="slide-subtitle tp-font-handlee">Annenin Huzuru, Çocuğun Sağlığı...</h4>
                            <h2 class="slide-title tp-font-lato-black">Bütüncül Gelişim</h2>
                            <h3 class="slide-desc tp-font-lato-light">ve Sağlık Takibi</h3>

                            <div class="slide-button">
                                <a asp-controller="Service" asp-action="Index" class="template-component-button template-component-button-style-1">Hizmetlerimiz<i></i></a>
                            </div>
                        </div>
                        <div class="slide-image">
                            <img src="media/image/_sample/slider/slider_slide2_img1.png" alt="Bebek Gelişimi">
                        </div>
                    </div>
                </div>

                <div class="swiper-slide">
                    <div class="slide-background" style="background-image: url('media/image/_sample/slider/slider_slide3_background.png');"></div>

                    <div class="slide-content template-main">
                        <div class="slide-text-wrapper">
                            <h4 class="slide-subtitle tp-font-handlee">Dünyanın Her Yerinden...</h4>
                            <h2 class="slide-title tp-font-lato-black">Uyku Koçluğu</h2>
                            <h3 class="slide-desc tp-font-lato-light">& Online Danışmanlık</h3>

                            <div class="slide-button">
                                <a asp-controller="Contact" asp-action="Index" class="template-component-button template-component-button-style-1">İletişime Geçin<i></i></a>
                            </div>
                        </div>
                        <div class="slide-image">
                            <img src="media/image/_sample/slider/slider_slide3_img1.png" alt="Uyku Eğitimi">
                        </div>
                    </div>
                </div>

            </div>

            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>

    </div>


    <!-- Section -->
    <div class="template-content-section template-padding-reset template-background-image">

        <div class="template-main">

            <div class="template-component-call-to-action template-component-call-to-action-style-2 template-section-white">
                <div class="template-component-call-to-action-content">
                    <div class="template-component-call-to-action-content-left">
                        <h3>Çocuğunuzun sağlığı ve gelişimi için güvenilir bir yol arkadaşı mı arıyorsunuz?</h3>
                    </div>
                    <div class="template-component-call-to-action-content-right">
                        <a asp-controller="Contact" asp-action="Index" class="template-component-button template-component-button-style-2 template-section-white">İletişime Geçin<i></i></a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Section -->
    <div class="template-content-section template-padding-bottom-5 template-background-color-2">

        <!-- Main -->
        <div class="template-main">

            <!-- Layout 50x50 -->
            <div class="template-layout-50x50 template-clear-fix">

                <div class="template-layout-column-left">

                    <div class="template-component-tab">
                        <ul class="template-align-left">
                            <li>
                                <a href="#template-tab-1">Genel Bakış</a>
                                <span></span>
                            </li>
                            <li>
                                <a href="#template-tab-2">Yaklaşımımız</a>
                                <span></span>
                            </li>
                        </ul>

                        <div id="template-tab-1">

                            <h4>Bilimsel temelli, güven veren ve sizi gerçekten dinleyen bir yaklaşım ile yanınızdayız.</h4>

                            <div class="template-component-feature template-component-feature-style-1 template-component-feature-position-left template-component-feature-size-medium">
                                <ul class="template-layout-100 template-clear-fix">

                                    <li class="template-layout-column-left">
                                        <div class="template-icon-feature template-icon-feature-name-clock-alt"></div>
                                        <h5>Yeterli Zaman & İlgi</h5>
                                        <p>Normali anormalden ayırabilmek ve sizi gerçekten dinleyebilmek için muayene sürelerini uzun tutuyor, aceleye getirmiyoruz.</p>
                                    </li>

                                    <li class="template-layout-column-left">
                                        <div class="template-icon-feature template-icon-feature-name-diagram-alt"></div>
                                        <h5>Bütüncül Takip</h5>
                                        <p>Sadece hastalık tedavisi değil; uyku eğitimi, beslenme ve gelişim takibi ile çocuğunuzun büyüme yolculuğuna rehberlik ediyoruz.</p>
                                    </li>
                                </ul>
                            </div>

                        </div>

                        <div id="template-tab-2">

                            <div class="template-component-feature template-component-feature-style-2 template-component-feature-position-left template-component-feature-size-medium">
                                <ul class="template-layout-100 template-clear-fix">

                                    <li class="template-layout-column-left">
                                        <div class="template-icon-feature template-icon-feature-name-screen"></div>
                                        <h5>Online Danışmanlık</h5>
                                        <p>Dünyanın neresinde olursanız olun, uzman desteğine ve sertifikalı uyku koçluğu hizmetimize online olarak ulaşabilirsiniz.</p>
                                    </li>

                                    <li class="template-layout-column-left">
                                        <div class="template-icon-feature template-icon-feature-name-heart"></div>
                                        <h5>Anne Dostu Felsefe</h5>
                                        <p>Felsefemizin merkezinde "annenin kendini iyi ve yeterli hissetmesi" vardır. Sizin huzurunuz, çocuğunuzun sağlığıdır.</p>
                                    </li>

                                    <li class="template-layout-column-left">
                                        <div class="template-icon-feature template-icon-feature-name-lab"></div>
                                        <h5>Bilimsel Temel</h5>
                                        <p>Uygulanan tedavi ve önerilerin gerekçelerini, güncel tıbbi bilgiler ışığında şeffaflıkla paylaşıyoruz.</p>
                                    </li>
                                </ul>
                            </div>

                        </div>
                    </div>

                </div>
                <!-- Right column -->
                <div class="template-layout-column-right">

                    <!-- Nivo slider -->
                    <div class="template-component-nivo-slider template-component-nivo-slider-style-1 template-preloader">
                        <div>
                            <img src="media/image/_sample/690x506/10.jpg" data-thumb="media/image/_sample/690x506/10.jpg" alt="" />
                            <img src="media/image/_sample/690x506/5.jpg" data-thumb="media/image/_sample/690x506/5.jpg" alt="" />
                            <img src="media/image/_sample/690x506/11.jpg" data-thumb="media/image/_sample/690x506/11.jpg" alt="" />
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>
    <!-- Section -->
    <div class="template-content-section template-padding-top-reset template-padding-bottom-5">

        <!-- Main -->
        <div class="template-main">

            <!-- Header and subheader -->
            <div class="template-component-header-subheader">
                <h2>Sertifikalarmız ve Katılım Belgelerimiz</h2>
                <h6>Mesleki gelişimimizi sürekli kılıyor, güncel tıbbi yaklaşımları yakından takip ediyoruz.</h6>
                <div></div>
            </div>

            <!-- Feature -->
            <!-- Section -->
            <div class="template-content-section template-padding-bottom-5 template-main">

                <!-- Gallery -->
                <div class="template-component-gallery">
                    <ul class="template-layout-33x33x33 template-clear-fix">

                        @{
                            // Listeyi index numarasıyla dönebilmek için ToList() yapıyoruz
                            var docList = DataRequestModel.Documents.ToList();
                        }

                        @for (int i = 0; i < docList.Count; i++)
                        {
                            var item = docList[i];
                            string columnClass = "";

                            // Modülo 3 mantığı ile sütun sırasını belirliyoruz
                            if (i % 3 == 0) { columnClass = "template-layout-column-left"; } // 1., 4., 7. resimler
                            else if (i % 3 == 1) { columnClass = "template-layout-column-center"; } // 2., 5., 8. resimler
                            else { columnClass = "template-layout-column-right"; } // 3., 6., 9. resimler

                            <li class="@columnClass">
                                <div class="template-component-image template-component-image-hover-slide-enable template-fancybox template-preloader">
                                    <a href="/img/@item.Image" data-fancybox-group="gallery-1">
                                        <img src="/img/@item.Image" alt="@item.Title" />
                                        <span><span><span></span></span></span>
                                    </a>
                                    <div>
                                        <h6>@item.Title</h6>
                                    </div>
                                </div>
                            </li>

                            // Satır Sonu Düzeltici (Clearfix)
                            // Her 3 resimde bir satırı sıfırlıyoruz ki resim boyutları farklıysa tasarım kaymasın
                            if ((i + 1) % 3 == 0)
                            {
                                <li style="clear: both; width: 100%; height: 0; padding: 0; margin: 0; display: block;"></li>
                            }
                        }

                    </ul>
                </div>

            </div>

        </div>

    </div>



    <!-- Section -->
    <div class="template-content-section template-padding-top-reset template-padding-bottom-5">

        <div class="template-main">

            <div class="template-component-header-subheader">
                <h2>Hizmetlerimiz</h2>
                <h6>Yenidoğan takibinden uyku eğitimine, sağlıklı çocuk izleminden online danışmanlığa kadar geniş bir yelpaze.</h6>
                <div></div>
            </div>



            <div class="template-component-divider template-component-divider-style-1"></div>

            <div class="template-layout-50x50 template-clear-fix">

                @foreach (var item in DataRequestModel.Services)
                {
                    <div class="template-layout-column-left template-margin-bottom-reset">
                        <div class="template-component-image template-component-image-hover-slide-enable">

                            <img src="/img/@item.Image" alt="@item.Title" />
                            <span><span><span></span></span></span>

                            <div>
                                <h5>@item.Title</h5>
                            </div>
                            <div class="template-align-center template-margin-top-2">
                                <a asp-controller="Service" asp-action="Detail" asp-route-slug="@item.Slug" class="template-component-button template-component-button-style-1">Daha Fazla<i></i></a>
                            </div>
                        </div>
                    </div>

                }


            </div>

        </div>
    </div>

    <!-- Section -->
    <div class="template-content-section template-padding-top-reset">

        <!-- Main -->
        <div class="template-main">

            <!-- Header and subheader -->
            <div class="template-component-header-subheader">
                <h2>Son Yazılarımız</h2>
                <h6>Çocuğunuzun sağlığı ve gelişimi için hazırladığımız güncel içerikler ve öneriler.</h6>
                <div></div>
            </div>
            @{
                var modelList = DataRequestModel.Blogs.ToList();
            }
            <!-- Recent posts -->
            <div class="template-component-recent-post template-component-recent-post-style-1">

                <div class="template-layout-33x33x33 template-clear-fix">

                    @for (int i = 0; i < modelList.Count; i++)
                    {
                        // --- DİNAMİK CLASS MANTIĞI ---
                        string columnClass = "";

                        // Modülo 3 işlemi: 0->Sol, 1->Orta, 2->Sağ
                        if (i % 3 == 0)
                        {
                            columnClass = "template-layout-column-left";
                        }
                        else if (i % 3 == 1)
                        {
                            columnClass = "template-layout-column-center";
                        }
                        else
                        {
                            columnClass = "template-layout-column-right";
                        }
                        // -----------------------------

                        <div class="@columnClass">
                            <div class="template-post">

                                <div class="template-post-section-preambule template-margin-bottom-2">
                                    <div class="template-component-image template-preloader">

                                        <img src="/img/@modelList[i].Image" alt="@modelList[i]" />
                                        <span><span><span></span></span></span>

                                    </div>
                                </div>

                                <div class="template-post-section-header template-align-center template-margin-bottom-2">
                                    <a href="#" class="template-post-date">
                                        @modelList[i].CreatedAt.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                    </a>
                                    <h5 class="template-post-header" style="margin-top:5px !important">
                                        <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@modelList[i].Slug">@modelList[i].Title</a>
                                    </h5>

                                </div>



                                @* <div class="template-align-center">
                            <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@modelList[i].Slug" class="template-component-button template-component-button-style-1">Devamını Oku<i></i></a>
                        </div> *@

                            </div>
                        </div>

                        // --- SATIR SONU KONTROLÜ (CLEAFIX) ---
                        // Eğer bu eleman 3'ün katıysa (yani sağ sütundaysa) veya listenin son elemanıysa
                        // float temizliği yapıyoruz ki sonraki satır düzgün başlasın.
                        if ((i + 1) % 3 == 0)
                        {
                            <div class="template-clear-fix template-margin-bottom-3"></div>
                        }
                    }

                </div>


            </div>

            <div class="template-align-center">

                <!-- Button -->
                <a asp-controller="Blog" asp-action="Index" class="template-component-button template-component-button-style-1">Tümünü Gör...<i></i></a>

            </div>

        </div>

    </div>



</div>
<style>
    /* Kartın Ana Çerçevesi */
    .template-post {
        background-color: #fff;
        border: 1px solid #f0f0f0; /* Çok hafif, zarif bir gri çizgi */
        border-radius: 12px; /* Modern yuvarlak köşeler */
        box-shadow: 0 4px 15px rgba(0,0,0,0.04); /* Hafif derinlik hissi veren gölge */
        overflow: hidden; /* Resmin köşelerden taşmasını engeller */
        transition: all 0.3s ease; /* Hover (üzerine gelme) animasyonu için */
        padding-bottom: 20px; /* Kartın altında biraz nefes alma boşluğu */
        height: 100%; /* Tüm kartların eşit yükseklikte durması için */
    }

        /* Fare Üzerine Gelince (Hover) Efekti */
        .template-post:hover {
            transform: translateY(-5px); /* Kartı hafifçe havaya kaldır */
            box-shadow: 0 10px 25px rgba(86, 80, 159, 0.15); /* Temanın mor rengiyle belirginleşen gölge */
            border-color: #CCCAE2; /* Çerçeve rengi hafifçe mora dönsün */
        }

    /* Resim Ayarları (Üst köşelerin kartla uyumlu oval olması için) */
    .template-post-section-preambule {
        margin-bottom: 15px !important;
    }

        .template-post-section-preambule img {
            border-radius: 12px 12px 0 0; /* Sadece üst köşeler oval */
            width: 100%;
            object-fit: cover; /* Resimlerin bozulmadan kutuyu doldurması için */
            aspect-ratio: 16 / 9; /* Resimlerin standart bir boyutta durması için (İsteğe bağlı) */
        }

    /* Yazıların Kenarlara Yapışmaması İçin İç Boşluk */
    .template-post-section-header {
        padding: 0 15px;
    }
</style>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var swiper = new Swiper(".main-slider", {
                loop: true,
                effect: "fade",
                speed: 1000,

                // --- EKLEMEN GEREKEN KISIM BURASI ---
                fadeEffect: {
                    crossFade: true
                },
                // ------------------------------------

                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
            });
        });
    </script>
}