<body class="template-page-home-1">
    @await Component.InvokeAsync("Navbar")
   
       
            @RenderBody()
    @await Component.InvokeAsync("Footer")
   @{
    // Telefon numarasını temizleme işlemleri
    string rawPhone = DataRequestModel.SiteSetting.Phone ?? "";
    string waNumber = System.Text.RegularExpressions.Regex.Replace(rawPhone, @"[^\d]", "");

    if (waNumber.StartsWith("0")) { waNumber = "9" + waNumber; }
    else if (!waNumber.StartsWith("90") && waNumber.Length > 0) { waNumber = "90" + waNumber; }
    
    string waMessage = System.Net.WebUtility.UrlEncode("Merhaba, web siteniz üzerinden ulaşıyorum. Bilgi ve randevu almak istiyorum.");
}

<div class="whatsapp-container">
    <a href="https://wa.me/@waNumber?text=@waMessage" target="_blank" class="whatsapp-link" title="WhatsApp'tan Bize Ulaşın">
        
        <div class="whatsapp-bubble">
            Bilgi ve randevu için iletişime geçiniz
        </div>

        <div class="whatsapp-icon-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24" fill="#ffffff">
