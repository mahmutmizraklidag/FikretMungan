<div class="template-footer">

	<div class="template-footer-top">

		<div class="template-main">

			<ul class="template-widget-list template-layout-33x33x33 template-clear-fix">

				<li class="template-layout-column-left">
					
					<div>
						<div class="template-widget-text">
							<img src="@Url.Content("~/media/image/foot_logo.png")" class="template-footer-logo template-margin-bottom-2" alt="logo" />
							<p><strong>'Annenin huzuru, çocuğun sağlığıdır'</strong> felsefesiyle yola çıkıyor; bilimsel temelli, güven veren ve sizi gerçekten dinleyen bir yaklaşımla çocuğunuzun büyüme yolculuğuna rehberlik ediyoruz.</p>
						</div>
					</div>
				</li>

				<li class="template-layout-column-center">
					<h6>
						<span>Hızlı Linkler</span>
						<span></span>
					</h6>
					<div>
						<div class="template-component-list template-component-list-style-1">
							<ul>
								<li><a asp-controller="Home" asp-action="Index">Anasayfa</a></li>
								<li><a asp-controller="About" asp-action="Index">Hakkımızda</a></li>
								<li><a asp-controller="Service" asp-action="Index">Hizmetlerimiz</a></li>
								<li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
								<li><a asp-controller="Document" asp-action="Index">Belgeler</a></li>
								<li><a asp-controller="Faqs" asp-action="Index">SSS</a></li>
								<li><a asp-controller="Contact" asp-action="Index">İletişim</a></li>
							</ul>
						</div>
					</div>
				</li>

				<li class="template-layout-column-right">
					<h6>
						<span>Bizi Takip Edin</span>
						<span></span>
					</h6>
					<div>
						<p class="template-margin-bottom-2">
							Çocuk sağlığı ve gelişimine dair en güncel bilimsel bilgilerden, ebeveynlik ipuçlarından ve duyurulardan haberdar olmak için sosyal medya hesaplarımızı takip edebilirsiniz.
						</p>

						<div class="template-component-social-icon template-component-social-icon-style-1 template-clear-fix">
							<ul>
								@if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Instagram))
								{
									<li><a href="@DataRequestModel.SiteSetting.Instagram" target="_blank" class="template-component-social-icon-instagram" title="Instagram"></a></li>
								}
								@if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Facebook))
								{
									<li><a href="@DataRequestModel.SiteSetting.Facebook" class="template-component-social-icon-facebook" target="_blank" title="Facebook"></a></li>
								}
								@if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.YouTube))
								{
									<li><a href="@DataRequestModel.SiteSetting.YouTube" class="template-component-social-icon-youtube" target="_blank" title="Youtube"></a></li>
								}
								@if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Twitter))
								{
									<li><a href="@DataRequestModel.SiteSetting.Twitter" class="template-component-social-icon-twitter" target="_blank" title="Twitter"></a></li>
								}
								
								
								
								
							</ul>
						</div>

						<div class="template-margin-top-2">

							@{
								// Telefon numarasını arama formatına uygun hale getirelim (Boşlukları temizle)
								string cleanPhone = DataRequestModel.SiteSetting.Phone?.Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "") ?? "";
							}
							<a href="tel:@cleanPhone" style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px; text-decoration: none; color: #ffffff;">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
								</svg>
								<span>@DataRequestModel.SiteSetting.Phone</span>
							</a>

							<a href="mailto:@DataRequestModel.SiteSetting.Email" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: #ffffff;">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
									<polyline points="22,6 12,13 2,6"></polyline>
								</svg>
								<span>@DataRequestModel.SiteSetting.Email</span>
							</a>

						</div>
					</div>
				</li>

			</ul>

		</div>
		<div class="template-align-center template-main">
			<div>
				&copy; 2026 <a href="https://www.ideiocreative.com" target="_blank">İdeio Creative</a>. Tüm Hakları Saklıdır.
			</div>
		</div>
	</div>

	

</div>


<style>
	/* Sadece Mobil Cihazlar İçin (768px altı) */
	@@media (max-width: 768px) {
		/* 1. Sağ sütunu görünür yap ve genişlet */
		.template-footer .template-layout-column-right {
			display: block !important;
			visibility: visible !important;
			width: 100% !important;
			text-align: center !important; /* Mobilde ikonları ortala */
			margin-top: 30px !important; /* Üstteki linklerle araya boşluk koy */
		}
		/* 2. Sosyal ikon kapsayıcısını görünür yap */
		.template-component-social-icon {
			display: block !important;
			visibility: visible !important;
			opacity: 1 !important;
			margin-bottom: 15px;
		}
			/* 3. İkon listesini (ul) yatayda ortala */
			.template-component-social-icon ul {
				display: inline-flex !important; /* Yan yana dizilmelerini sağlar */
				justify-content: center;
				padding: 0;
				margin: 0 auto;
				float: none !important; /* Sağa/Sola yaslanmayı iptal et */
			}
		/* 4. İletişim bilgilerini (Tel/Mail) de ortala */
		.template-footer .template-layout-column-right .template-margin-top-2 {
			display: flex;
			flex-direction: column;
			align-items: center; /* Ortala */
			gap: 10px;
		}
	}
</style>