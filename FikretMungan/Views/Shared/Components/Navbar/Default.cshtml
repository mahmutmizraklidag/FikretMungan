<div class="template-header">

    <div class="header-top-bar" style="background-color: #f9f9f9; border-bottom: 1px solid #eee; padding: 8px 0; font-family: 'Lato', sans-serif; font-size: 13px;">
        <div class="template-main template-clear-fix">

            <div style="float: left; display: flex; gap: 15px; align-items: center; height: 30px;">

                @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Phone))
                {
                    // Telefon numarasındaki boşlukları temizleyerek href içine koyuyoruz ki arama hatasız çalışsın
                    string cleanPhone = DataRequestModel.SiteSetting.Phone.Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");

                    <a href="tel:@cleanPhone" style="display: flex; align-items: center; gap: 5px; color: #666; text-decoration: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#56509F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <span>@DataRequestModel.SiteSetting.Phone</span>
                    </a>
                }

                @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Email))
                {
                    <a href="mailto:@DataRequestModel.SiteSetting.Email" class="hide-on-mobile" style="display: flex; align-items: center; gap: 5px; color: #666; text-decoration: none;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#56509F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        <span>@DataRequestModel.SiteSetting.Email</span>
                    </a>
                }
            </div>

            <div style="float: right;">
                <div class="template-component-social-icon template-component-social-icon-style-1">
                   
                    <ul class="template-clear-fix">
                        @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Instagram))
                        {
                            <li><a href="@DataRequestModel.SiteSetting.Instagram" target="_blank" class="template-component-social-icon-instagram" title="Instagram" style="width: 24px; height: 24px; line-height: 24px; font-size: 12px;"></a></li>
                        }
                        @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Facebook))
                        {
                            <li><a href="@DataRequestModel.SiteSetting.Facebook" class="template-component-social-icon-facebook" target="_blank" title="Facebook" style="width: 24px; height: 24px; line-height: 24px; font-size: 12px;"></a></li>
                        }
                        @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.Twitter))
                        {
                            <li><a href="@DataRequestModel.SiteSetting.Twitter" class="template-component-social-icon-twitter" target="_blank" title="Twitter" style="width: 24px; height: 24px; line-height: 24px; font-size: 12px;"></a></li>
                        }
                       
                        @if (!string.IsNullOrEmpty(DataRequestModel.SiteSetting.YouTube))
                        {
                            <li><a href="@DataRequestModel.SiteSetting.YouTube" class="template-component-social-icon-youtube" target="_blank" title="Youtube" style="width: 24px; height: 24px; line-height: 24px; font-size: 12px;"></a></li>
                        }
                    </ul>
                </div>
            </div>

        </div>
    </div>
    <div class="template-header-top">

        <div class="template-main template-clear-fix">

            <div class="template-header-top-logo">
                <a asp-controller="Home" asp-action="Index">
                    <img src="@Url.Content("~/media/image/mungan_logo.png")" alt="Logo" />
                </a>
            </div>

            <div class="template-header-top-menu template-clear-fix">

                <nav class="template-component-menu-default">
                    <ul class="sf-menu template-clear-fix">
                        <li class="sf-mega-enable-0">
                            <a asp-controller="Home" asp-action="Index"><span class="template-icon-menu template-icon-menu-home"></span>Anasayfa</a>
                        </li>
                        <li class="sf-mega-enable-1">
                            <a asp-controller="About" asp-action="Index"><span class="template-icon-menu template-icon-menu-chat"></span>Hakkımızda</a>
                        </li>
                        <li class="sf-mega-enable-1">
                            <a asp-controller="Service" asp-action="Index"><span class="template-icon-menu template-icon-menu-printer"></span>Hizmetlerimiz</a>
                        </li>
                        <li class="sf-mega-enable-1">
                            <a asp-controller="Blog" asp-action="Index"><span class="template-icon-menu template-icon-menu-pencil"></span>Merak Ettikleriniz</a>
                        </li>
                        <li class="sf-mega-enable-1">
                            <a asp-controller="Document" asp-action="Index"><span class="template-icon-menu template-icon-menu-document"></span>Sertifikalarımız</a>
                        </li>
                        <li class="sf-mega-enable-1">
                            <a asp-controller="Faqs" asp-action="Index"><span class="template-icon-menu template-icon-menu-faq"></span>Sıkça Sorulan Sorular</a>
                        </li>
                        <li class="sf-mega-enable-0">
                            <a asp-controller="Contact" asp-action="Index"><span class="template-icon-menu template-icon-menu-envelope"></span>İletişim</a>
                        </li>
                    </ul>
                </nav>

                <nav class="template-component-menu-responsive">
                    <ul class="template-clear-fix">
                        <li>
                            <a href="#">Menü<span></span></a>
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Anasayfa<span></span></a></li>
                                <li><a asp-controller="About" asp-action="Index">Hakkımızda<span></span></a></li>
                                <li><a asp-controller="Service" asp-action="Index">Hizmetlerimiz<span></span></a></li>
                                <li><a asp-controller="Blog" asp-action="Index">Merak Ettikleriniz<span></span></a></li>
                                <li><a asp-controller="Document" asp-action="Index">Sertifikalarımız<span></span></a></li>
                                <li><a asp-controller="Faqs" asp-action="Index">Sıkça Sorulan Sorular<span></span></a></li>
                                <li><a asp-controller="Contact" asp-action="Index">İletişim<span></span></a></li>
                            </ul>
                        <li>
                    </ul>
                </nav>

            </div>

        </div>
    </div>

    <div class="template-header-bottom">
    </div>

</div>

<style>
    @@media (max-width: 768px) {
        /* Mobilde mail adresi çok yer kaplarsa gizle */
        .hide-on-mobile {
            display: none !important;
        }
    }
</style>